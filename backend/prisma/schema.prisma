generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  STUDENT
  TEACHER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum SemesterStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("semester_status")
}

enum SubjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("subject_status")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

enum ProjectMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("project_member_role")
}

enum ProjectMemberStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("project_member_status")
}

enum WorkspaceType {
  PERSONAL
  SUBJECT
  PROJECT

  @@map("workspace_type")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED

  @@map("workspace_status")
}

enum WorkspaceRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER

  @@map("workspace_role")
}

enum WorkspaceMembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED

  @@map("workspace_membership_status")
}

enum ClassMemberRole {
  CLASS_ADMIN
  STUDENT

  @@map("class_member_role")
}

enum NoteType {
  LECTURE
  LAB_REPORT
  EXAM_PREP
  PROJECT_LOG
  MEETING_MINUTES
  GENERAL

  @@map("note_type")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum ScheduleEventType {
  CLASS
  EXAM
  DEADLINE
  GROUP_MEETING
  PERSONAL

  @@map("schedule_event_type")
}

enum ShareTargetType {
  NOTE
  TASK
  PROJECT
  COLLECTION

  @@map("share_target_type")
}

enum ShareAccessLevel {
  VIEW
  EDIT
  ADMIN

  @@map("share_access_level")
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  googleId     String?    @unique @map("google_id") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(100)
  avatarUrl    String?    @map("avatar_url")
  timezone     String     @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Relations
  refreshTokens            RefreshToken[]
  semesters                Semester[]
  subjects                 Subject[]
  projects                 Project[]
  projectMemberships       ProjectMember[]
  notes                    Note[]
  tasks                    Task[]
  taskAssignments          TaskAssignee[]
  tags                     Tag[]
  scheduleEvents           ScheduleEvent[]
  backups                  BackupRecord[]
  createdShares            ResourceShare[]    @relation("SharedResourcesOwner")
  receivedShares           ResourceShare[]    @relation("SharedResourcesRecipient")
  taughtClasses            CourseClass[]      @relation("ClassTeacher")
  classMemberships         ClassMember[]
  ledGroups                StudyGroup[]       @relation("GroupLeader")
  groupMemberships         StudyGroupMember[]
  submittedReports         ProgressReport[]   @relation("ReportSubmitter")
  reviewedReports          ProgressReport[]   @relation("ReportReviewer")
  workspacesOwned          Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]  @relation("WorkspaceMemberUser")
  workspaceInvitationsSent WorkspaceMember[]  @relation("WorkspaceInviter")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Semester {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  name         String         @db.VarChar(100)
  academicYear String         @map("academic_year") @db.VarChar(50)
  startDate    DateTime?      @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  status       SemesterStatus @default(ACTIVE)
  isCurrent    Boolean        @default(false) @map("is_current")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  projects       Project[]
  scheduleEvents ScheduleEvent[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, isCurrent])
  @@map("semesters")
}

model Subject {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  semesterId String        @map("semester_id") @db.Uuid
  name       String        @db.VarChar(150)
  code       String?       @db.VarChar(50)
  credits    Int           @default(3)
  lecturer   String?       @db.VarChar(100)
  color      String?       @default("#3b82f6") @db.VarChar(20)
  status     SubjectStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester       Semester        @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  projects       Project[]
  notes          Note[]
  tasks          Task[]
  scheduleEvents ScheduleEvent[]
  workspace      Workspace?

  @@index([userId])
  @@index([semesterId])
  @@index([userId, deletedAt])
  @@index([userId, semesterId, deletedAt])
  @@index([status, deletedAt])
  @@map("subjects")
}

model CourseClass {
  id          String    @id @default(uuid()) @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid
  name        String    @db.VarChar(150)
  code        String?   @db.VarChar(50)
  term        String?   @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  teacher      User               @relation("ClassTeacher", fields: [teacherId], references: [id])
  members      ClassMember[]
  groupMembers StudyGroupMember[]
  groups       StudyGroup[]
  projects     Project[]

  @@index([teacherId, deletedAt])
  @@map("course_classes")
}

model ClassMember {
  classId  String          @map("class_id") @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  role     ClassMemberRole @default(STUDENT)
  joinedAt DateTime        @default(now()) @map("joined_at") @db.Timestamptz(6)

  courseClass CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
  @@map("class_members")
}

model StudyGroup {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  leaderId  String   @map("leader_id") @db.Uuid
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courseClass CourseClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  leader      User               @relation("GroupLeader", fields: [leaderId], references: [id])
  members     StudyGroupMember[]
  projects    Project[]

  @@index([classId])
  @@map("study_groups")
}

model StudyGroupMember {
  groupId  String   @map("group_id") @db.Uuid
  classId  String   @map("class_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group       StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseClass CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@unique([classId, userId])
  @@index([userId])
  @@map("study_group_members")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  semesterId  String?       @map("semester_id") @db.Uuid
  subjectId   String?       @map("subject_id") @db.Uuid
  classId     String?       @map("class_id") @db.Uuid
  groupId     String?       @map("group_id") @db.Uuid
  name        String        @db.VarChar(150)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester        Semester?        @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  notes           Note[]
  tasks           Task[]
  courseClass     CourseClass?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  studyGroup      StudyGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  progressReports ProgressReport[]
  workspace       Workspace?

  @@index([userId])
  @@index([subjectId])
  @@index([classId, groupId])
  @@index([userId, deletedAt])
  @@index([userId, status, deletedAt])
  @@index([userId, dueDate])
  @@map("projects")
}

model ProgressReport {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  submittedById   String    @map("submitted_by_id") @db.Uuid
  progressPercent Int       @map("progress_percent")
  summary         String    @db.Text
  blockers        String?   @db.Text
  reviewScore     Int?      @map("review_score")
  reviewComment   String?   @map("review_comment") @db.Text
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User    @relation("ReportSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?   @relation("ReportReviewer", fields: [reviewedById], references: [id])

  @@index([projectId, createdAt])
  @@map("progress_reports")
}

model ProjectMember {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @map("project_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  role      ProjectMemberRole   @default(MEMBER)
  status    ProjectMemberStatus @default(ACCEPTED)
  joinedAt  DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

model Workspace {
  id        String          @id @default(uuid()) @db.Uuid
  type      WorkspaceType
  name      String          @db.VarChar(150)
  ownerId   String          @map("owner_id") @db.Uuid
  status    WorkspaceStatus @default(ACTIVE)
  timezone  String          @default("Asia/Ho_Chi_Minh") @db.VarChar(100)
  version   Int             @default(1)
  subjectId String?         @unique @map("subject_id") @db.Uuid
  projectId String?         @unique @map("project_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  subject Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  project Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  members WorkspaceMember[]

  @@index([ownerId])
  @@index([type, status, deletedAt])
  @@index([createdAt, id])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                    @id @default(uuid()) @db.Uuid
  workspaceId String                    @map("workspace_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  invitedById String?                   @map("invited_by_id") @db.Uuid
  role        WorkspaceRole             @default(MEMBER)
  status      WorkspaceMembershipStatus @default(PENDING)
  version     Int                       @default(1)
  invitedAt   DateTime                  @default(now()) @map("invited_at") @db.Timestamptz(6)
  expiresAt   DateTime?                 @map("expires_at") @db.Timestamptz(6)
  joinedAt    DateTime?                 @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([workspaceId, status, joinedAt, id])
  @@index([invitedById])
  @@map("workspace_members")
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  subjectId  String?   @map("subject_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  title      String    @db.VarChar(255)
  content    String    @db.Text
  noteType   NoteType  @default(LECTURE) @map("note_type")
  isPinned   Boolean   @default(false) @map("is_pinned")
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  noteTags  NoteTag[]
  taskLinks TaskNoteLink[]

  @@index([userId])
  @@index([subjectId])
  @@index([projectId])
  @@index([userId, deletedAt])
  @@index([userId, subjectId, deletedAt])
  @@index([userId, isPinned, deletedAt])
  @@index([userId, createdAt])
  @@map("notes")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String?  @default("#64748b") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags NoteTag[]
  taskTags TaskTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  subjectId   String?      @map("subject_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees TaskAssignee[]
  taskTags  TaskTag[]
  noteLinks TaskNoteLink[]

  @@index([userId])
  @@index([subjectId])
  @@index([projectId])
  @@index([status])
  @@index([userId, deletedAt])
  @@index([userId, status, deletedAt])
  @@index([userId, priority, deletedAt])
  @@index([userId, dueDate, deletedAt])
  @@map("tasks")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("task_assignees")
}

model TaskNoteLink {
  taskId String @map("task_id") @db.Uuid
  noteId String @map("note_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([taskId, noteId])
  @@map("task_note_links")
}

model ScheduleEvent {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  semesterId     String?           @map("semester_id") @db.Uuid
  subjectId      String?           @map("subject_id") @db.Uuid
  title          String            @db.VarChar(150)
  location       String?           @db.VarChar(150)
  eventType      ScheduleEventType @default(CLASS) @map("event_type")
  startTime      DateTime          @map("start_time") @db.Timestamptz(6)
  endTime        DateTime          @map("end_time") @db.Timestamptz(6)
  isRecurring    Boolean           @default(false) @map("is_recurring")
  recurrenceRule String?           @map("recurrence_rule") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([semesterId])
  @@index([startTime, endTime])
  @@index([userId, deletedAt])
  @@index([userId, startTime, endTime, deletedAt])
  @@map("schedule_events")
}

model ResourceShare {
  id               String           @id @default(uuid()) @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  targetType       ShareTargetType  @map("target_type")
  targetId         String           @map("target_id") @db.Uuid
  sharedWithUserId String?          @map("shared_with_user_id") @db.Uuid
  sharedWithEmail  String?          @map("shared_with_email") @db.VarChar(255)
  accessLevel      ShareAccessLevel @default(VIEW) @map("access_level")
  shareToken       String?          @unique @map("share_token") @db.VarChar(64)
  isPublic         Boolean          @default(false) @map("is_public")
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          User  @relation("SharedResourcesOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithUser User? @relation("SharedResourcesRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([sharedWithUserId])
  @@index([targetType, targetId])
  @@index([shareToken])
  @@map("resource_shares")
}

model BackupRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileSize  Int      @map("file_size")
  checksum  String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_records")
}
